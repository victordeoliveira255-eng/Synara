PORT=3000
NODE_ENV=development
JWT_SECRET=synara-dev-secret-change-me
DATABASE_URL=
# Producao: connection string do Supabase (Session pooler, porta 5432).
# SSL e ativado automaticamente para host remoto; use PGSSL=disable para desligar.
PGSSL=
OPENAI_API_KEY=
# Google Gemini: provedor PRINCIPAL de geracao de texto (opcional).
# GEMINI_API_KEY e SEGREDO: defina no painel do provedor (Render -> Environment).
GEMINI_API_KEY=
# Modelo de texto do Gemini (nao sensivel).
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Provedor de texto preferido: auto (Gemini -> OpenAI) | gemini | openai.
AI_TEXT_PROVIDER=auto
# P0-9/P0-10 — Orcamentos de embeddings (limites de custo por inicializacao).
# 1) REINDEXACAO de vetores existentes: DESLIGADA por padrao. Quando ligada,
#    regenera vetores cujo conteudo mudou ou cujo formato difere do atual
#    (inclusive legado). Teto por execucao em EMBEDDINGS_REINDEX_MAX (padrao 50).
# 2) CRIACAO de vetores para conteudo NOVO na sincronizacao automatica: limite
#    PROPRIO em EMBEDDINGS_CREATE_MAX (padrao 25). E um caminho de custo distinto;
#    EMBEDDINGS_REINDEX_MAX NAO o controla. O que exceder fica PENDENTE e e
#    retomado na proxima inicializacao (nada e apagado nem marcado como concluido).
# EMBEDDINGS_REINDEX=0
# EMBEDDINGS_REINDEX_MAX=50
# EMBEDDINGS_CREATE_MAX=25
# Opcional: endpoint alternativo do Gemini (testes locais com stub).
# GEMINI_BASE_URL=
ADMIN_EMAIL=
ALLOWED_ORIGINS=http://localhost:3000
