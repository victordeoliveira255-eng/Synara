PORT=3000
NODE_ENV=development
JWT_SECRET=synara-dev-secret-change-me
DATABASE_URL=
# Producao: connection string do Supabase (Session pooler, porta 5432).
# SSL e ativado automaticamente para host remoto; use PGSSL=disable para desligar.
PGSSL=
OPENAI_API_KEY=
# Google Gemini: provedor PRINCIPAL de geracao de texto (opcional).
# GEMINI_API_KEY e SEGREDO: defina no painel do provedor (Render -> Environment).
GEMINI_API_KEY=
# Modelo de texto do Gemini (nao sensivel).
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Provedor de texto preferido: auto (Gemini -> OpenAI) | gemini | openai.
AI_TEXT_PROVIDER=auto
# Opcional: endpoint alternativo do Gemini (testes locais com stub).
# GEMINI_BASE_URL=
ADMIN_EMAIL=
ALLOWED_ORIGINS=http://localhost:3000
